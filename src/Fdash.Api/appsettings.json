{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://localhost:5000",
  "Collector": {
    "//": "Transport: Auto | File | Rcon. Auto nimmt die Dateiausgabe des Mods, sobald sie da ist, sonst RCON.",
    "Transport": "Auto",
    "ScriptOutputPath": "%APPDATA%\\Factorio\\script-output",
    "PollIntervalMs": 1000,

    "//rcon": "RCON ist optional. Noetig nur fuer Transport=Rcon (Dashboard auf anderer Maschine) und fuer Auto-Research. Passwort NICHT hier eintragen - siehe appsettings.Local.json oder die Umgebungsvariable Collector__RconPassword (zwei Unterstriche).",
    "Host": "127.0.0.1",
    "RconPort": 27015,
    "RconPassword": "",

    "SaveIdOverride": null,
    "AutoResearchEnabled": false,
    "AutoResearchIntervalSeconds": 15,
    "ResearchBlacklistPrefixes": [],
    "MaxInfiniteLevel": null,
    "PowerSatisfactionWarn": 0.95,
    "FuelLowPct": 0.25,
    "StallSecondsWarn": 60
  },
  "Storage": {
    "DbPath": "fdash.db"
  },
  "Icons": {
    "Enabled": true,
    "FactorioDataPath": "C:\\Program Files\\Factorio\\data",
    "ModsPath": "%APPDATA%\\Factorio\\mods",
    "DataRawDumpPath": "%APPDATA%\\Factorio\\script-output\\data-raw-dump.json"
  }
}
