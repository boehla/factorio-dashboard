# Zeilenenden im Repo normalisieren, im Arbeitsverzeichnis plattformueblich.
# Ohne das erzeugt der Wechsel zwischen Windows-Editor und Linux-CI Diffs, in
# denen jede Zeile geaendert aussieht.
* text=auto

*.cs      text diff=csharp
*.lua     text
*.json    text
*.md      text
*.yml     text
*.cfg     text

# Windows-Skripte brauchen CRLF, sonst stolpert cmd.exe darueber.
*.bat     text eol=crlf
*.ps1     text eol=crlf

*.png     binary
*.jpg     binary
*.zip     binary
*.db      binary

# Der Mod wird lokal (build-mod.ps1) und im Release-Job (windows-latest) gepackt.
# Factorio vergleicht beim Verbinden Pruefsummen ueber die Script-Dateien. Ohne
# festes eol haengt der Inhalt am autocrlf des jeweiligen Checkouts, und ein
# lokaler Build passt nicht zum Portal-Zip: Clients koennen dann nicht joinen
# ("mod script files are not identical"). Deshalb hier ueberall LF.
mod/fdash-exporter/** text=auto eol=lf
